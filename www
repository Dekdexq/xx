							break

						end

					end

				end

			end

		end)

		if not foundTimer then

			local currentMin = tonumber(os.date("%M"))

			local minToNextHour = 60 - currentMin

			if Library and Library.Notification then

				Library:Notification({ Title = "Boss Status", Description = "Estimated Cooldown: " .. minToNextHour .. " mins (Check portal for exact)", Duration = 5, Icon = "85279746515974"})

			end

		end

	end,

})

